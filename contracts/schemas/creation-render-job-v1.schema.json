{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrld.local/schemas/creation-render-job-v1.schema.json",
  "title": "WRLD Creation Render Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "job_id", "attempt_id", "submission_id", "project_id", "target", "request_fingerprint", "plan_fingerprint", "state", "phase", "progress", "queue_position", "created_at", "started_at", "updated_at", "last_heartbeat_at", "finished_at", "retry_of_attempt_id", "recovery", "diagnostic", "result_available"],
  "properties": {
    "contract_version": {"const": "wrld-creation-render-job/1.0"},
    "job_id": {"$ref": "creation-render-common-v1.schema.json#/$defs/uuid"},
    "attempt_id": {"$ref": "creation-render-common-v1.schema.json#/$defs/uuid"},
    "submission_id": {"$ref": "creation-render-common-v1.schema.json#/$defs/uuid"},
    "project_id": {"$ref": "creation-render-common-v1.schema.json#/$defs/uuid"},
    "target": {"$ref": "creation-render-common-v1.schema.json#/$defs/target"},
    "request_fingerprint": {"$ref": "creation-render-common-v1.schema.json#/$defs/sha256"},
    "plan_fingerprint": {"$ref": "creation-render-common-v1.schema.json#/$defs/sha256"},
    "state": {"enum": ["queued", "running", "cancel_requested", "cancelled", "failed", "succeeded"]},
    "phase": {"enum": ["queued", "preparing", "snapshotting_sources", "normalizing_audio", "assembling_audio", "encoding", "probing_output", "decoding_output", "publishing_artifact", "publishing_report", "reconciling", "completed"]},
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": ["phase_percent", "processed_samples", "total_samples", "current_source", "total_sources", "elapsed_seconds", "eta_seconds"],
      "properties": {
        "phase_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "processed_samples": {"type": ["integer", "null"], "minimum": 0},
        "total_samples": {"type": "integer", "minimum": 1},
        "current_source": {"type": ["integer", "null"], "minimum": 1},
        "total_sources": {"type": "integer", "minimum": 1},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "eta_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "queue_position": {"type": ["integer", "null"], "minimum": 1},
    "created_at": {"$ref": "creation-render-common-v1.schema.json#/$defs/timestamp"},
    "started_at": {"oneOf": [{"$ref": "creation-render-common-v1.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "updated_at": {"$ref": "creation-render-common-v1.schema.json#/$defs/timestamp"},
    "last_heartbeat_at": {"oneOf": [{"$ref": "creation-render-common-v1.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "finished_at": {"oneOf": [{"$ref": "creation-render-common-v1.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "retry_of_attempt_id": {"oneOf": [{"$ref": "creation-render-common-v1.schema.json#/$defs/uuid"}, {"type": "null"}]},
    "recovery": {"enum": ["none", "reconciling", "retryable", "indeterminate"]},
    "diagnostic": {"oneOf": [{"$ref": "creation-render-common-v1.schema.json#/$defs/diagnostic"}, {"type": "null"}]},
    "result_available": {"type": "boolean"}
  }
}
