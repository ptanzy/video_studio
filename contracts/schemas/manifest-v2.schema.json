{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrld.example/schemas/manifest-v2.schema.json",
  "title": "WRLD Video Studio manifest v2 (structural subset)",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "album",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "required": [
        "brand",
        "channel"
      ],
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "album": {
      "type": "object",
      "required": [
        "id",
        "title",
        "artist",
        "artwork"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "artwork": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "video": {
      "type": "object"
    },
    "publishing": {
      "type": "object"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "music": {
            "type": "object"
          },
          "shorts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "start_seconds",
                "end_seconds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "end_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "title": {
                  "type": "string"
                },
                "color_profile": {
                  "enum": [
                    "auto",
                    "original",
                    "cool",
                    "warm",
                    "lavender",
                    "teal",
                    "dark"
                  ]
                },
                "fade_in_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "fade_out_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
