{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://wrld.local/schemas/project-validation-v1.schema.json",
  "title": "WRLD project validation v1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "project_id", "valid", "errors", "warnings"],
  "properties": {
    "contract_version": {"const": "wrld-project-validation/1.0"}, "project_id": {"type": "string", "minLength": 1}, "valid": {"type": "boolean"},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/message"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/message"}}
  },
  "$defs": {"message": {"type": "object", "additionalProperties": false, "required": ["code", "message", "details"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "details": {"type": "object"}}}}
}
