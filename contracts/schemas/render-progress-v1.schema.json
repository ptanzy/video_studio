{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrld.local/schemas/render-progress-v1.schema.json",
  "title": "WRLD Render Progress v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "job_id", "attempt_id", "phase",
    "phase_progress_percent", "current_track", "total_tracks",
    "processed_duration_seconds", "total_duration_seconds", "elapsed_seconds",
    "eta_seconds", "last_progress_at", "last_heartbeat_at",
    "failure_phase", "diagnostic_reference"
  ],
  "properties": {
    "contract_version": {"const": "wrld-render-progress/1.0"},
    "job_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "phase": {
      "enum": [
        "preparing", "snapshotting_sources", "normalizing_audio",
        "assembling_audio", "encoding", "probing_output", "decoding_output",
        "publishing_artifacts", "publishing_report", "completed"
      ]
    },
    "phase_progress_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "current_track": {"type": ["integer", "null"], "minimum": 1},
    "total_tracks": {"type": ["integer", "null"], "minimum": 1},
    "processed_duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "total_duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "eta_seconds": {"type": ["number", "null"], "minimum": 0},
    "last_progress_at": {"type": "string", "format": "date-time"},
    "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "failure_phase": {
      "type": ["string", "null"],
      "enum": [
        null, "preparing", "snapshotting_sources", "normalizing_audio",
        "assembling_audio", "encoding", "probing_output", "decoding_output",
        "publishing_artifacts", "publishing_report", "completed"
      ]
    },
    "diagnostic_reference": {"type": ["string", "null"], "minLength": 1}
  }
}
