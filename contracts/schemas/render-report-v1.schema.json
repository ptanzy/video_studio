{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrld.local/schemas/render-report-v1.schema.json",
  "title": "WRLD Render Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "artifacts", "history", "updated_at"],
  "properties": {
    "schema_version": {"const": "wrld-render-report/1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "byte_size", "verification"],
      "properties": {
        "kind": {"enum": ["album_video", "track_video", "chapters"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 0},
        "verification": {"const": "verified"},
        "media": {"type": "object"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "attempt_id", "request_digest", "result"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "#/$defs/sha256"},
        "renderer_version": {"type": "string", "minLength": 1},
        "input_fingerprints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "sha256"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "toolchain": {"type": "object"},
        "result": {"type": "object"}
      }
    }
  }
}
