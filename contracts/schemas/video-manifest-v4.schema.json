{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrld.local/schemas/video-manifest-v4.schema.json",
  "title": "WRLD Video Album Manifest v4 Player",
  "type": "object", "additionalProperties": false,
  "required": ["format", "album", "visual", "tracks", "render"],
  "properties": {
    "format": {"const": "wrld-video-album/4.0"},
    "album": {"type": "object", "additionalProperties": false, "required": ["id", "title", "artist", "parent_channel", "genre_channel"], "properties": {
      "id": {"$ref": "#/$defs/stableId"}, "title": {"$ref": "#/$defs/nonemptyString"}, "artist": {"$ref": "#/$defs/nonemptyString"},
      "parent_channel": {"$ref": "#/$defs/nonemptyString"}, "genre_channel": {"$ref": "#/$defs/nonemptyString"}
    }},
    "visual": {"type": "object", "additionalProperties": false, "required": ["background"], "properties": {
      "background": {"$ref": "#/$defs/relativePath"}, "cover": {"$ref": "#/$defs/relativePath"}, "thumbnail": {"$ref": "#/$defs/relativePath"}
    }},
    "tracks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "number", "title", "audio"], "properties": {
        "id": {"$ref": "#/$defs/stableId"}, "number": {"type": "integer", "minimum": 1}, "title": {"$ref": "#/$defs/nonemptyString"}, "audio": {"$ref": "#/$defs/relativePath"},
        "clips": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/stableId"}}, "additionalProperties": true}},
        "music": {"type": "object", "additionalProperties": false, "required": ["intended", "analyzed"], "properties": {
          "intended": {"type": "object", "additionalProperties": false, "required": ["bpm", "key"], "properties": {"bpm": {"type": ["number", "null"], "minimum": 1, "maximum": 400}, "key": {"type": ["string", "null"], "minLength": 1}}},
          "analyzed": {"type": "object", "additionalProperties": false, "required": ["bpm", "key"], "properties": {"bpm": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bpmMeasurement"}]}, "key": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/keyMeasurement"}]}}}
        }}
      }
    }},
    "render": {"type": "object", "additionalProperties": false, "required": ["profile_id", "effects"], "properties": {
      "profile_id": {"const": "youtube-1080p30-player-v1"}, "effects": {"$ref": "https://wrld.local/schemas/video-effects-v3.schema.json"}
    }}
  },
  "$defs": {
    "nonemptyString": {"type": "string", "minLength": 1},
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "bpmMeasurement": {"type": "object", "additionalProperties": false, "required": ["value", "confidence", "reliable"], "properties": {"value": {"type": "number", "minimum": 1, "maximum": 400}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reliable": {"type": "boolean"}}},
    "keyMeasurement": {"type": "object", "additionalProperties": false, "required": ["value", "confidence", "reliable"], "properties": {"value": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reliable": {"type": "boolean"}}}
  }
}
